\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Feature Importance Analysis.} (A) Catastrophic task: dominant feature explodes 4.5$\times $ while maintaining top rank. (B) Robust task: importance redistributes across features with ranking reshuffle. (C) Importance dynamics: catastrophic tasks show concentrated increase; robust tasks distribute increases. (D) Ranking stability: robust tasks allow greater rank changes. Despite $\sim $0\% Jaccard similarity, coverage drops differ by 700$\times $.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:shap}{{1}{4}{\textbf {Feature Importance Analysis.} (A) Catastrophic task: dominant feature explodes 4.5$\times $ while maintaining top rank. (B) Robust task: importance redistributes across features with ranking reshuffle. (C) Importance dynamics: catastrophic tasks show concentrated increase; robust tasks distribute increases. (D) Ranking stability: robust tasks allow greater rank changes. Despite $\sim $0\% Jaccard similarity, coverage drops differ by 700$\times $}{figure.caption.4}{}}
