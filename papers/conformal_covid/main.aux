\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Stratified Correlation Analysis by Shift Severity. The concentration mechanism applies only to severe-shift scenarios with complete feature turnover. Moderate-shift tasks exhibit different mechanism (feature stability).}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:stratified_correlation}{{3}{6}{Stratified Correlation Analysis by Shift Severity. The concentration mechanism applies only to severe-shift scenarios with complete feature turnover. Moderate-shift tasks exhibit different mechanism (feature stability)}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {SHAP Concentration Predicts Coverage Degradation in Severe-Shift Scenarios.} Scatter plot shows correlation between SHAP concentration and coverage drop for 8 tasks with complete feature turnover (Spearman $\rho =0.714$, $p=0.047$). Exploratory data from 4 tasks with moderate feature stability (Jaccard 0.13--0.86, shown in lighter colors) reveal a different mechanism where feature stability determines robustness. The 40\% concentration threshold applies to severe-shift scenarios with Jaccard $\approx $0.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:n12_correlation}{{3}{6}{\textbf {SHAP Concentration Predicts Coverage Degradation in Severe-Shift Scenarios.} Scatter plot shows correlation between SHAP concentration and coverage drop for 8 tasks with complete feature turnover (Spearman $\rho =0.714$, $p=0.047$). Exploratory data from 4 tasks with moderate feature stability (Jaccard 0.13--0.86, shown in lighter colors) reveal a different mechanism where feature stability determines robustness. The 40\% concentration threshold applies to severe-shift scenarios with Jaccard $\approx $0}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces ACI Does Not Help Under Severe Shift}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:aci}{{4}{6}{ACI Does Not Help Under Severe Shift}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Retraining Frequency Impact on Catastrophic Task (sales-shipcond). Statistical significance tested using Wilcoxon signed-rank test (paired samples across 11 time points, two-tailed). Quarterly retraining provides optimal cost-effectiveness.}}{6}{table.caption.12}\protected@file@percent }
\newlabel{tab:retrain}{{5}{6}{Retraining Frequency Impact on Catastrophic Task (sales-shipcond). Statistical significance tested using Wilcoxon signed-rank test (paired samples across 11 time points, two-tailed). Quarterly retraining provides optimal cost-effectiveness}{table.caption.12}{}}
