\citation{romano2019conformalized}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Retraining restores coverage for catastrophic tasks.} Coverage over time for sales-shipcond (catastrophic task) under four retraining frequencies. Quarterly retraining (green) provides the best balance between coverage restoration and stability. Monthly retraining (blue) shows high variance and occasional failures. No retraining (red) exhibits severe degradation post-COVID (month 6). Robust task (sales-office, not shown) maintains 99.8\% coverage regardless of retraining.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:retrain}{{4}{7}{\textbf {Retraining restores coverage for catastrophic tasks.} Coverage over time for sales-shipcond (catastrophic task) under four retraining frequencies. Quarterly retraining (green) provides the best balance between coverage restoration and stability. Monthly retraining (blue) shows high variance and occasional failures. No retraining (red) exhibits severe degradation post-COVID (month 6). Robust task (sales-office, not shown) maintains 99.8\% coverage regardless of retraining}{figure.caption.13}{}}
